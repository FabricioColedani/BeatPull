{
  "name": "beatpull",
  "version": "1.0.0",
  "description": "Descargador de audio minimalista",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build-css": "tailwindcss -i ./src/renderer/styles.css -o ./src/renderer/output.css --watch",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "autoprefixer": "^10.5.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  },
  "build": {
    "appId": "com.beatpull.app",
    "productName": "BeatPull",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}